# VITE_SITE_URL: The live site's address, e.g. https://www.example.com (no trailing slash).
# Used for canonical links, social previews and sitemap.xml.
# Optional on Netlify: if unset, the build uses Netlify's URL variable (the site's primary domain).
VITE_SITE_URL=

# DISCORD_WEBHOOK_URL: Where booking requests are posted.
# Set this in Netlify > Site configuration > Environment variables (and in .env for local dev).
DISCORD_WEBHOOK_URL=
